teaching_load [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#1F4E79" COLSPAN="3"><FONT COLOR="white"><B>teaching_load</B></FONT></TD></TR><TR><TD BGCOLOR="#FFF2CC" ALIGN="LEFT" PORT="load_id">PK</TD><TD BGCOLOR="#FFF2CC" ALIGN="LEFT">load_id</TD><TD BGCOLOR="#FFF2CC" ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD></TR><TR><TD BGCOLOR="#E2F0D9" ALIGN="LEFT" PORT="group_id">FK</TD><TD BGCOLOR="#E2F0D9" ALIGN="LEFT">group_id</TD><TD BGCOLOR="#E2F0D9" ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD></TR><TR><TD BGCOLOR="#E2F0D9" ALIGN="LEFT" PORT="discipline_id">FK</TD><TD BGCOLOR="#E2F0D9" ALIGN="LEFT">discipline_id</TD><TD BGCOLOR="#E2F0D9" ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD></TR><TR><TD BGCOLOR="#E2F0D9" ALIGN="LEFT" PORT="teacher_id">FK</TD><TD BGCOLOR="#E2F0D9" ALIGN="LEFT">teacher_id</TD><TD BGCOLOR="#E2F0D9" ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD></TR></TABLE>>];
student_groups:specialty_id -> specialties:specialty_id;
