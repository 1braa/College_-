digraph G { rankdir=LR; nodesep=0.35; ranksep=0.9; splines=true; bgcolor="white";
node [shape=plain, fontname="DejaVu Sans", fontsize=10];
edge [color="#555555", arrowhead=nonetee, arrowtail=crow, dir=both, penwidth=1.1];
specialties [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#1F4E79" COLSPAN="3"><FONT COLOR="white"><B>specialties</B></FONT></TD></TR><TR><TD BGCOLOR="#FFF2CC" ALIGN="LEFT" PORT="specialty_id">PK</TD><TD BGCOLOR="#FFF2CC" ALIGN="LEFT">specialty_id</TD><TD BGCOLOR="#FFF2CC" ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT" PORT="code"></TD><TD BGCOLOR="white" ALIGN="LEFT">code</TD><TD BGCOLOR="white" ALIGN="LEFT"><FONT COLOR="#444444">varchar(10)</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT" PORT="name"></TD><TD BGCOLOR="white" ALIGN="LEFT">name</TD><TD BGCOLOR="white" ALIGN="LEFT"><FONT COLOR="#444444">varchar(150)</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT" PORT="qualification"></TD><TD BGCOLOR="white" ALIGN="LEFT">qualification</TD><TD BGCOLOR="white" ALIGN="LEFT"><FONT COLOR="#444444">varchar(150)</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT" PORT="duration_months"></TD><TD BGCOLOR="white" ALIGN="LEFT">duration_months</TD><TD BGCOLOR="white" ALIGN="LEFT"><FONT COLOR="#444444">smallint</FONT></TD></TR></TABLE>>];
student_groups [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#1F4E79" COLSPAN="3"><FONT COLOR="white"><B>student_groups</B></FONT></TD></TR><TR><TD BGCOLOR="#FFF2CC" ALIGN="LEFT" PORT="group_id">PK</TD><TD BGCOLOR="#FFF2CC" ALIGN="LEFT">group_id</TD><TD BGCOLOR="#FFF2CC" ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT" PORT="name"></TD><TD BGCOLOR="white" ALIGN="LEFT">name</TD><TD BGCOLOR="white" ALIGN="LEFT"><FONT COLOR="#444444">varchar(20)</FONT></TD></TR><TR><TD BGCOLOR="#E2F0D9" ALIGN="LEFT" PORT="specialty_id">FK</TD><TD BGCOLOR="#E2F0D9" ALIGN="LEFT">specialty_id</TD><TD BGCOLOR="#E2F0D9" ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT" PORT="admission_year"></TD><TD BGCOLOR="white" ALIGN="LEFT">admission_year</TD><TD BGCOLOR="white" ALIGN="LEFT"><FONT COLOR="#444444">smallint</FONT></TD></TR><TR><TD BGCOLOR="#E2F0D9" ALIGN="LEFT" PORT="curator_id">FK</TD><TD BGCOLOR="#E2F0D9" ALIGN="LEFT">curator_id ?</TD><TD BGCOLOR="#E2F0D9" ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD></TR></TABLE>>];
